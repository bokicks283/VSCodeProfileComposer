{
  "schemaVersion": 1,
  "routes": [
    {
      "id": "python-settings",
      "kind": "setting",
      "match": {
        "type": "prefix",
        "value": "python."
      },
      "destination": {
        "type": "component",
        "name": "python"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "Portable Python settings belong to the reusable Python component."
    },
    {
      "id": "eslint-settings",
      "kind": "setting",
      "match": {
        "type": "prefix",
        "value": "eslint."
      },
      "destination": {
        "type": "component",
        "name": "web"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "Portable ESLint behavior belongs to the Web component."
    },
    {
      "id": "react-snippets-settings",
      "kind": "setting",
      "match": {
        "type": "prefix",
        "value": "reactSnippets.settings."
      },
      "destination": {
        "type": "component",
        "name": "react"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "Portable React snippet behavior belongs to the React component."
    },
    {
      "id": "lua-settings",
      "kind": "setting",
      "match": {
        "type": "prefix",
        "value": "Lua."
      },
      "destination": {
        "type": "component",
        "name": "lua"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "Portable Lua language-server behavior belongs to the Lua component."
    },
    {
      "id": "intelephense-settings",
      "kind": "setting",
      "match": {
        "type": "prefix",
        "value": "intelephense."
      },
      "destination": {
        "type": "component",
        "name": "php"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "Portable Intelephense behavior belongs to the PHP component."
    },
    {
      "id": "php-debug-settings",
      "kind": "setting",
      "match": {
        "type": "prefix",
        "value": "php.debug."
      },
      "destination": {
        "type": "component",
        "name": "php"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "Portable Xdebug client behavior belongs to the PHP component."
    },
    {
      "id": "php-validation-setting",
      "kind": "setting",
      "match": {
        "type": "exact",
        "value": "php.validate.enable"
      },
      "destination": {
        "type": "component",
        "name": "php"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "PHP validation-provider selection belongs to the PHP component."
    },
    {
      "id": "python-extension",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "ms-python.python"
      },
      "destination": {
        "type": "component",
        "name": "python"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "The Microsoft Python extension is owned by the Python component."
    },
    {
      "id": "react-snippets-extension",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "r5n.es-js-snippets"
      },
      "destination": {
        "type": "component",
        "name": "react"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "Modern React snippets are owned by the React component."
    },
    {
      "id": "lua-language-server-extension",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "sumneko.lua"
      },
      "destination": {
        "type": "component",
        "name": "lua"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "Lua language intelligence is owned by the Lua component."
    },
    {
      "id": "stylua-extension",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "JohnnyMorganz.stylua"
      },
      "destination": {
        "type": "component",
        "name": "lua"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "Lua formatting is owned by the Lua component."
    },
    {
      "id": "intelephense-extension",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "bmewburn.vscode-intelephense-client"
      },
      "destination": {
        "type": "component",
        "name": "php"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "PHP language intelligence is owned by the PHP component."
    },
    {
      "id": "xdebug-extension",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "xdebug.php-debug"
      },
      "destination": {
        "type": "component",
        "name": "php"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "PHP Xdebug client support is owned by the PHP component."
    },
    {
      "id": "mysql-mariadb-driver-extension",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "mtxr.sqltools-driver-mysql"
      },
      "destination": {
        "type": "component",
        "name": "mysql-mariadb"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "The SQLTools MySQL and MariaDB driver is owned by the MySQL and MariaDB component."
    },
    {
      "id": "nginx-configuration-extension",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "ahmadalli.vscode-nginx-conf"
      },
      "destination": {
        "type": "component",
        "name": "apache-nginx"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "NGINX configuration support is owned by the Apache and NGINX component."
    },
    {
      "id": "apache-configuration-extension",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "mrmlnc.vscode-apache"
      },
      "destination": {
        "type": "component",
        "name": "apache-nginx"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "Apache configuration syntax is owned by the Apache and NGINX component."
    },
    {
      "id": "project-zomboid-syntax-extension",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "cyberbobjr.pz-syntax-extension"
      },
      "destination": {
        "type": "component",
        "name": "project-zomboid"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "Project Zomboid script support is owned by the Project Zomboid component."
    },
    {
      "id": "project-zomboid-studio-extension",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "escapepz.pzstudio"
      },
      "destination": {
        "type": "component",
        "name": "project-zomboid"
      },
      "source": "repository-policy",
      "status": "approved",
      "reason": "Project Zomboid project tooling is owned by the Project Zomboid component."
    },
    {
      "id": "user-extension-github.copilot-chat",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "github.copilot-chat"
      },
      "destination": {
        "type": "component",
        "name": "main"
      },
      "source": "user-confirmed",
      "status": "approved",
      "reason": "Confirmed during interactive synchronization."
    },
    {
      "id": "user-extension-sandcastle.vscode-open",
      "kind": "extension",
      "match": {
        "type": "exact",
        "value": "sandcastle.vscode-open"
      },
      "destination": {
        "type": "component",
        "name": "main"
      },
      "source": "user-confirmed",
      "status": "approved",
      "reason": "Confirmed during interactive synchronization."
    }
  ]
}
