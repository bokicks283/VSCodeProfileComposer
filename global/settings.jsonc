{
  // These settings are owned by VS Code's built-in Default profile and apply
  // to every named profile. Keep the list and values together.
  "workbench.settings.applyToAllProfiles": [
    "accessibility.dimUnfocused.enabled",
    "accessibility.signals.terminalBell",
    "accessibility.verbosity.panelChat",
    "accessibility.verbosity.terminal",
    "accessibility.verbosity.terminalChatOutput",
    "cSpell.suggestionMenuType",
    "cSpell.useCustomDecorations",
    "diffEditor.codeLens",
    "editor.accessibilityPageSize",
    "editor.autoClosingDelete",
    "editor.autoClosingOvertype",
    "editor.codeActionWidget.includeNearbyQuickFixes",
    "editor.suggest.shareSuggestSelections",
    "editor.suggest.showStatusBar",
    "explorer.compactFolders",
    "explorer.confirmDelete",
    "explorer.confirmDragAndDrop",
    "explorer.incrementalNaming",
    "git.allowForcePush",
    "git.autofetch",
    "git.enableSmartCommit",
    "git.ignoreMissingGitWarning",
    "git.openRepositoryInParentFolders",
    "scm.alwaysShowActions",
    "scm.alwaysShowRepositories",
    "security.workspace.trust.enabled",
    "security.workspace.trust.untrustedFiles",
    "settingsSync.ignoredSettings",
    "terminal.integrated.accessibleViewFocusOnCommandExecution",
    "terminal.integrated.allowedLinkSchemes",
    "terminal.integrated.confirmOnKill",
    "terminal.integrated.copyOnSelection",
    "terminal.integrated.cursorBlinking",
    "terminal.integrated.enableMultiLinePasteWarning",
    "terminal.integrated.enableVisualBell",
    "terminal.integrated.initialHint",
    "workbench.editor.closeOnFileDelete",
    "workbench.editor.empty.hint",
    "workbench.editor.enablePreviewFromCodeNavigation",
    "workbench.editor.enablePreviewFromQuickOpen",
    "workbench.editor.openSideBySideDirection",
    "workbench.editor.tabSizing",
    "workbench.editor.tabSizingFixedMaxWidth",
    "workbench.editor.tabSizingFixedMinWidth",
    "workbench.editor.titleScrollbarSizing",
    "workbench.editor.untitled.labelFormat",
    "workbench.editor.wrapTabs"
  ],

  "accessibility.dimUnfocused.enabled": true,
  "accessibility.signals.terminalBell": {
    "sound": "on"
  },
  "accessibility.verbosity.panelChat": false,
  "accessibility.verbosity.terminal": false,
  "accessibility.verbosity.terminalChatOutput": false,

  // Keep spelling issues out of Problems and show corrections next to the word.
  "cSpell.suggestionMenuType": "quickFix",
  "cSpell.useCustomDecorations": true,

  "diffEditor.codeLens": true,
  "editor.accessibilityPageSize": 14,
  "editor.autoClosingDelete": "always",
  "editor.autoClosingOvertype": "always",
  "editor.codeActionWidget.includeNearbyQuickFixes": true,
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggest.showStatusBar": true,

  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.incrementalNaming": "smart",

  "git.allowForcePush": true,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.ignoreMissingGitWarning": true,
  "git.openRepositoryInParentFolders": "always",
  "scm.alwaysShowActions": true,
  "scm.alwaysShowRepositories": true,

  "security.workspace.trust.enabled": true,
  "security.workspace.trust.untrustedFiles": "open",

  // Keep the machine-specific Todo Tree executable out of Settings Sync.
  // The leading '-' preserves the existing choice to sync window zoom.
  "settingsSync.ignoredSettings": [
    "-window.zoomLevel",
    "todo-tree.ripgrep.ripgrep"
  ],

  "terminal.integrated.accessibleViewFocusOnCommandExecution": false,
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "openDialog",
    "dialog"
  ],
  "terminal.integrated.confirmOnKill": "never",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.enableVisualBell": true,
  "terminal.integrated.initialHint": false,

  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.openSideBySideDirection": "down",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.tabSizingFixedMaxWidth": 200,
  "workbench.editor.tabSizingFixedMinWidth": 38,
  "workbench.editor.titleScrollbarSizing": "large",
  "workbench.editor.untitled.labelFormat": "name",
  "workbench.editor.wrapTabs": true
}
