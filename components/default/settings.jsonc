{
  // Shared portable and daily-driver behavior used by every profile.
  "accessibility.dimUnfocused.enabled": true,
  "accessibility.signals.terminalBell": {
    "sound": "on"
  },
  "accessibility.verbosity.panelChat": false,
  "accessibility.verbosity.terminal": false,
  "accessibility.verbosity.terminalChatOutput": false,

  "diffEditor.codeLens": true,
  "editor.accessibilityPageSize": 14,
  "editor.autoClosingBrackets": "always",
  "editor.autoClosingDelete": "always",
  "editor.autoClosingOvertype": "always",
  "editor.autoClosingQuotes": "always",
  "editor.codeActionWidget.includeNearbyQuickFixes": true,
  "editor.insertSpaces": true,
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggest.showStatusBar": true,

  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.incrementalNaming": "smart",

  "files.associations": {
    ".env": "dotenv",
    "*.bash": "shellscript",
    "*.bat": "bat",
    "*.cfg": "properties",
    "*.cmd": "bat",
    "*.ini": "properties",
    "*.md": "markdown",
    "*.ps1": "powershell",
    "*.psd1": "powershell",
    "*.psm1": "powershell",
    "*.sh": "shellscript",
    "*.toml": "toml",
    "*.zsh": "shellscript"
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  "git.allowForcePush": true,
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.ignoreMissingGitWarning": true,
  "git.openRepositoryInParentFolders": "always",
  "scm.alwaysShowActions": true,
  "scm.alwaysShowRepositories": true,

  "security.workspace.trust.enabled": true,
  "security.workspace.trust.untrustedFiles": "open",

  "terminal.explorerKind": "both",
  "terminal.integrated.accessibleViewFocusOnCommandExecution": false,
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "openDialog",
    "dialog"
  ],
  "terminal.integrated.confirmOnKill": "never",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.enableVisualBell": true,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.persistentSessionScrollback": 1000,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.shellIntegration.environmentReporting": true,

  "todo-tree.filtering.excludeGlobs": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/bower_components/**",
    "**/build/**",
    "**/.vscode/**",
    "**/.github/**",
    "**/_output/**",
    "**/*.min.*",
    "**/*.map"
  ],
  "todo-tree.filtering.ignoreGitSubmodules": true,
  "todo-tree.filtering.useBuiltInExcludes": "file and search excludes",
  "todo-tree.general.showActivityBarBadge": true,
  "todo-tree.general.showIconsInsteadOfTagsInStatusBar": true,
  "todo-tree.general.statusBar": "tags",
  "todo-tree.tree.showCountsInTree": true,

  "workbench.editor.closeOnFileDelete": true,
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.openSideBySideDirection": "down",
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.tabSizingFixedMaxWidth": 200,
  "workbench.editor.tabSizingFixedMinWidth": 38,
  "workbench.editor.titleScrollbarSizing": "large",
  "workbench.editor.untitled.labelFormat": "name",
  "workbench.editor.wrapTabs": true,

  // General daily-driver preferences shared by every profile.
  "[markdown]": {
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "on",
      "strings": "on",
      "other": "on"
    }
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },

  "debug.toolBarLocation": "docked",
  "editor.colorDecoratorsActivatedOn": "click",
  "editor.minimap.scale": 2,
  "editor.minimap.showSlider": "always",
  "editor.parameterHints.cycle": false,
  "editor.quickSuggestionsDelay": 5,
  "editor.semanticTokenColorCustomizations": {
    "enabled": true
  },
  "editor.showDeprecated": false,
  "editor.suggest.localityBonus": true,
  "editor.suggest.showReferences": false,
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.tabSize": 2,

  "files.autoSave": "afterDelay",

  "rainbow_csv.comment_prefix": "#",

  "search.quickOpen.includeSymbols": true,
  "search.searchView.keywordSuggestions": true,

  "task.problemMatchers.neverPrompt": false,

  "vsicons.dontShowNewVersionMessage": true,
  "workbench.colorTheme": "One Dark Pro Darker",
  "workbench.editorLargeFileConfirmation": 4096,
  "workbench.iconTheme": "vscode-icons",
  "workbench.settings.enableNaturalLanguageSearch": false
}
